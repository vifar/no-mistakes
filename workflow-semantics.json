{
  "env": {
    "GOMAXPROCS": "8"
  },
  "jobs": {
    "check": {
      "RunsOn": [
        "self-hosted",
        "Linux",
        "X64",
        "king-server",
        "no-mistakes"
      ],
      "If": "github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository",
      "TimeoutMinutes": 15,
      "Steps": [
        {
          "Name": "",
          "Uses": "actions/checkout@v6",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "",
          "With": {
            "persist-credentials": "false",
            "ref": "${{ github.event.pull_request.head.sha || github.sha }}"
          }
        },
        {
          "Name": "",
          "Uses": "actions/setup-go@v6",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "",
          "With": {
            "cache": "false",
            "go-version": "1.27.1"
          }
        },
        {
          "Name": "Check formatting",
          "Uses": "",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "test -z \"$(gofmt -l .)\"",
          "With": null
        },
        {
          "Name": "Check generated skill and vet",
          "Uses": "",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "make lint",
          "With": null
        }
      ]
    },
    "e2e": {
      "RunsOn": [
        "self-hosted",
        "Linux",
        "X64",
        "king-server",
        "no-mistakes"
      ],
      "If": "github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository",
      "TimeoutMinutes": 90,
      "Steps": [
        {
          "Name": "",
          "Uses": "actions/checkout@v6",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "",
          "With": {
            "persist-credentials": "false",
            "ref": "${{ github.event.pull_request.head.sha || github.sha }}"
          }
        },
        {
          "Name": "",
          "Uses": "actions/setup-go@v6",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "",
          "With": {
            "cache": "false",
            "go-version": "1.27.1"
          }
        },
        {
          "Name": "End-to-end journeys with temporary daemon cleanup",
          "Uses": "",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "make e2e",
          "With": null
        }
      ]
    },
    "test": {
      "RunsOn": [
        "self-hosted",
        "Linux",
        "X64",
        "king-server",
        "no-mistakes"
      ],
      "If": "github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository",
      "TimeoutMinutes": 90,
      "Steps": [
        {
          "Name": "",
          "Uses": "actions/checkout@v6",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "",
          "With": {
            "persist-credentials": "false",
            "ref": "${{ github.event.pull_request.head.sha || github.sha }}"
          }
        },
        {
          "Name": "",
          "Uses": "actions/setup-go@v6",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "",
          "With": {
            "cache": "false",
            "go-version": "1.27.1"
          }
        },
        {
          "Name": "Full Linux race suite",
          "Uses": "",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "bash scripts/race.sh",
          "With": null
        },
        {
          "Name": "Build Linux CLI",
          "Uses": "",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "go build -o bin/no-mistakes ./cmd/no-mistakes",
          "With": null
        },
        {
          "Name": "Cross-compile desktop CLI targets",
          "Uses": "",
          "If": "",
          "Shell": "",
          "Env": null,
          "Run": "set -eu\nfor target in darwin/amd64 darwin/arm64 windows/amd64 windows/arm64 linux/arm64; do\n  CGO_ENABLED=0 GOOS=\"${target%/*}\" GOARCH=\"${target#*/}\" go build -o \"$RUNNER_TEMP/no-mistakes-${target%/*}-${target#*/}\" ./cmd/no-mistakes\ndone\n",
          "With": null
        }
      ]
    }
  }
}